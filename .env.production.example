# === .env de PRODUCCIÓN (Plesk) ===
# Copia este archivo como .env en el servidor y rellena los valores reales.

APP_NAME="Web Master Colombia"
APP_ENV=production
APP_KEY=            # se genera con: php artisan key:generate
APP_DEBUG=false
APP_URL=https://tudominio.com   # tu dominio real con https

APP_LOCALE=es
APP_FALLBACK_LOCALE=es

# --- Base de datos (créala en Plesk: Bases de datos) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nombre_bd_produccion
DB_USERNAME=usuario_bd
DB_PASSWORD=contraseña_fuerte_bd

# --- Sesiones / caché ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true      # cookies solo por HTTPS (importante en prod)
CACHE_STORE=database
QUEUE_CONNECTION=database

# --- Logs ---
LOG_CHANNEL=stack
LOG_LEVEL=error                 # en prod, solo errores

# --- Correo (opcional; no lo usamos por ahora) ---
MAIL_MAILER=log
